{

    "manifest_version": 3,
    "name": "Retro Web",
    "version": "1.0.0",
    "description": "make websites look like 2010 again",
    
    
    "icons": {

        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },

    "permissions": [
        "storage"
    ],

    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "css": ["styles/global.css"],
            "js": ["scripts/detector.js"],
            "run_at": "document_start"

        }
    ],


    "web_accessible_resources": [
        {
            "resources": ["styles/global.css"],
            "matches": ["<all_urls>"]
        }
    ],

    "action": {
        "default_title": "Retro web",
        "default_popup": "popup/popup.html"
    },

    "background": {

        "service_worker": "scripts/background.js"
        
    }
}